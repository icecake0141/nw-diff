# NW-Diff v2 Environment Configuration
# Copy this file to .env and fill in your values.

# Required for local startup script and application runtime.
DEVICE_PASSWORD=your_device_password_here

# Required for the local startup script.
# Use one of dev/development/local/test to omit NW_DIFF_API_TOKEN.
NW_DIFF_ENV=development

# Required only when NW_DIFF_ENV is not dev/development/local/test.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NW_DIFF_API_TOKEN=your_secure_api_token_here

# Optional: HTTP Basic Authentication credentials.
# NW_DIFF_BASIC_USER=admin
# Development only: plain password.
# NW_DIFF_BASIC_PASSWORD=your_plain_password_here
# Preferred for production: hashed password.
# Generate with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password'))"
# NW_DIFF_BASIC_PASSWORD_HASH=your_hashed_password_here

# Optional: runtime paths.
# DB_URL=sqlite:///./nw_diff_v2.db
# ARTIFACT_ROOT=./artifacts_v2
# APP_LOG_PATH=./logs/nw-diff.log
# HOSTS_CSV=hosts.csv
# COMMAND_PROFILES_OVERRIDE_YAML=command_profiles/device_commands.override.yaml

# Optional: task worker controls.
# TASK_WORKER_ENABLED=true
# TASK_WORKER_THREADS=1
# TASK_WORKER_POLL_SECONDS=0.5

# Optional: event stream timing.
# TASK_STREAM_SLEEP_SECONDS=0.25
# TASK_STREAM_HEARTBEAT_SECONDS=10.0

# Optional: capture conflict handling and lock timeout.
# BATCH_CONFLICT_POLICY=all_or_nothing
# HOST_LOCK_TIMEOUT_SECONDS=3600

# Optional: readiness API thresholds.
# READINESS_MAX_QUEUED=100
# READINESS_MAX_RUNNING=20
# READINESS_MAX_LOCKED=100

# Optional: cutover decision thresholds (used by scripts/evaluate-v2-cutover.py).
# V2_CUTOVER_MAX_QUEUED=0
# V2_CUTOVER_MAX_RUNNING=5
# V2_CUTOVER_MAX_FAILED=0
