[Unit]
Description=NW-Diff v2 API
After=network.target

[Service]
Type=simple
User=nw-diff
Group=nw-diff
WorkingDirectory=/opt/nw-diff
EnvironmentFile=/opt/nw-diff/.env
ExecStart=/opt/nw-diff/.venv/bin/uvicorn nw_diff_v2.main:app --host 0.0.0.0 --port 8000 --app-dir src
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
